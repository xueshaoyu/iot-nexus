        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="创建时间" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="False" Description="更新时间" />
      </Columns>
    </Table>
    <Table Name="Rule" Description="规则。基于属性、事件、上下线触发的条件动作规则">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Name" DataType="String" Master="True" Nullable="False" Description="名称" />
        <Column Name="Enable" DataType="Boolean" Description="启用" />
        <Column Name="TriggerType" DataType="String" Length="20" Description="触发类型。Property/Event/Online/Offline" />
        <Column Name="ProductId" DataType="Int32" Map="Product@Id@Name" Description="产品。0表示全部" />
        <Column Name="GroupId" DataType="Int32" Map="DeviceGroup@Id@Name" Description="分组。0表示全部" />
        <Column Name="DeviceId" DataType="Int32" Map="Device@Id@Name" Description="设备。0表示全部" />
        <Column Name="EventName" DataType="String" Description="事件名。事件触发时匹配的事件标识，空表示任意" />
        <Column Name="ConditionLogic" DataType="String" Length="10" Description="条件逻辑。All全部满足，Any任一满足" />
        <Column Name="Conditions" DataType="String" Length="-1" Description="条件。Json数组，元素为{property,operator,value}" />
        <Column Name="Actions" DataType="String" Length="-1" Description="动作。Json数组，元素为{type,config}" />
        <Column Name="SilenceSeconds" DataType="Int32" Description="静默期。同一设备触发后在该时间内不再重复执行，单位秒" />
        <Column Name="Triggers" DataType="Int32" Description="触发次数" />
        <Column Name="LastTrigger" DataType="DateTime" Description="最后触发" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="创建时间" Category="扩展" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="False" Description="更新时间" Category="扩展" />
        <Column Name="Remark" DataType="String" Length="500" Description="备注" Category="扩展" />
      </Columns>
      <Indexes>
        <Index Columns="Name" />
