    <Table Name="BatchJob" Description="批量控制。按产品、分组或设备列表批量下发的属性设置或服务调用任务" MaxCacheCount="0">
      <Columns>
        <Column Name="Id" DataType="Int64" PrimaryKey="True" DataScale="time" Description="编号" />
        <Column Name="Kind" DataType="String" Length="20" Description="种类。property属性设置，service服务调用" />
        <Column Name="Name" DataType="String" Master="True" Description="名称。属性或服务标识符" />
        <Column Name="ScopeType" DataType="String" Length="20" Description="范围类型。Product/Group/Devices" />
        <Column Name="ScopeId" DataType="Int32" Description="范围编号。产品或分组编号" />
        <Column Name="Scope" DataType="String" Length="2000" Description="范围。Json描述" />
        <Column Name="InputData" DataType="String" Length="2000" Description="输入。属性值或服务参数" />
        <Column Name="Total" DataType="Int32" Description="总数" />
        <Column Name="Succeeded" DataType="Int32" Description="成功" />
        <Column Name="Pending" DataType="Int32" Description="待回复。已下发或排队等待设备拉取" />
        <Column Name="Failed" DataType="Int32" Description="失败" />
        <Column Name="Skipped" DataType="Int32" Description="跳过" />
