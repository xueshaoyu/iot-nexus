<?xml version="1.0" encoding="utf-8"?>
<EntityModel xmlns:xs="http://www.w3.org/2001/XMLSchema-instance" xs:schemaLocation="https://newlifex.com https://newlifex.com/Model202509.xsd" Document="https://newlifex.com/xcode/model" ModelVersion="2.0.2026.130" xmlns="https://newlifex.com/Model202509.xsd">
  <Option>
    <!--类名模板。其中{name}替换为Table.Name，如{name}Model/I{name}Dto等-->
    <ClassNameTemplate />
    <!--显示名模板。其中{displayName}替换为Table.DisplayName-->
    <DisplayNameTemplate />
    <!--基类。可能包含基类和接口，其中{name}替换为Table.Name-->
    <BaseClass>Entity</BaseClass>
    <!--命名空间-->
    <Namespace>IoTPlatform.Data</Namespace>
    <!--引用命名空间-->
    <ExtendNameSpace />
    <!--输出目录-->
    <Output>./Entity/</Output>
    <!--是否使用中文文件名。默认false-->
    <ChineseFileName>False</ChineseFileName>
    <!--用于生成Copy函数的参数类型。例如{name}或I{name}-->
    <ModelNameForCopy />
    <!--带有索引器。实现IModel接口-->
    <HasIModel>True</HasIModel>
    <!--可为null上下文。生成String?等-->
    <Nullable>True</Nullable>
    <!--数据库连接名-->
    <ConnName>IoT</ConnName>
    <!--模型类模版。设置后生成模型类，用于接口数据传输，例如{name}Model-->
    <ModelClass />
    <!--模型类输出目录。默认当前目录的Models子目录-->
    <ModelsOutput>.\Models\</ModelsOutput>
    <!--模型接口模版。设置后生成模型接口，用于约束模型类和实体类，例如I{name}-->
    <ModelInterface />
    <!--模型接口输出目录。默认当前目录的Interfaces子目录-->
    <InterfacesOutput>.\Interfaces\</InterfacesOutput>
    <!--用户实体转为模型类的模型类。例如{name}或{name}DTO-->
    <ModelNameForToModel />
    <!--命名格式。Default/Upper/Lower/Underline-->
    <NameFormat>Default</NameFormat>
    <!--魔方区域显示名-->
    <DisplayName>物联网</DisplayName>
    <!--魔方控制器输出目录-->
    <CubeOutput />
  </Option>
  <Tables>
    <Table Name="Product" Description="产品。设备的类型定义，包含物模型（属性、事件、服务）与接入协议">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Name" DataType="String" Master="True" Nullable="False" Description="名称" />
        <Column Name="Code" DataType="String" Nullable="False" Description="编码。ProductKey，全局唯一，用于MQTT主题" />
        <Column Name="Category" DataType="String" Description="类别" />
        <Column Name="Protocol" DataType="String" Description="接入协议。MQTT/HTTP/Driver" />
        <Column Name="BrokerProfileId" DataType="String" Description="默认 MQTT 服务器。空表示使用平台默认（Mode/ActiveBroker）" />
        <Column Name="Codec" DataType="String" Description="数据编解码。MQTT/HTTP上报的载荷格式，如Json/Alink" />
        <Column Name="DriverName" DataType="String" Description="驱动名称。Driver协议时使用的NewLife.IoT驱动，如ModbusTcp/Simulator" />
        <Column Name="DriverParameter" DataType="String" Length="2000" Description="驱动参数。Json格式的默认驱动参数，设备可覆盖" />
        <Column Name="PollInterval" DataType="Int32" Description="采集间隔。驱动轮询间隔，单位毫秒" />
        <Column Name="OnlineTimeout" DataType="Int32" Description="离线超时。超过该时间无心跳判定离线，单位秒，0表示使用全局配置" />
        <Column Name="Enable" DataType="Boolean" Description="启用" />
        <Column Name="DeviceCount" DataType="Int32" Description="设备数" />
        <Column Name="FunctionBlocks" DataType="String" Length="4000" Description="自定义模块。Json数组，元素为{functionBlockId,functionBlockName}。空表示仅默认模块" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="创建时间" Category="扩展" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="False" Description="更新时间" Category="扩展" />
        <Column Name="Remark" DataType="String" Length="500" Description="备注" Category="扩展" />
      </Columns>
      <Indexes>
        <Index Columns="Code" Unique="True" />
      </Indexes>
    </Table>
    <Table Name="ThingProperty" Description="产品属性。物模型属性定义，描述设备运行时状态，可附带驱动点位地址">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="ProductId" DataType="Int32" Map="Product@Id@Name" Description="产品" />
        <Column Name="Identifier" DataType="String" Nullable="False" Description="标识符。属性唯一标识，如temperature" />
        <Column Name="Name" DataType="String" Master="True" Description="名称" />
        <Column Name="DataType" DataType="String" Description="数据类型。int/float/double/text/date/bool/enum/struct/array，兼容历史 string" />
        <Column Name="Unit" DataType="String" Description="单位" />
        <Column Name="UnitName" DataType="String" Description="单位名称" />
        <Column Name="Min" DataType="Double" Description="最小值" />
        <Column Name="Max" DataType="Double" Description="最大值" />
        <Column Name="Step" DataType="Double" Description="步长" />
        <Column Name="Length" DataType="Int32" Description="长度。text 最大长度，或 array 元素个数上限" />
        <Column Name="AccessMode" DataType="String" Length="10" Description="访问模式。r只读，w只写，rw读写" />
        <Column Name="Required" DataType="Boolean" Description="是否必选" />
        <Column Name="Specs" DataType="String" Length="4000" Description="数据类型规格。阿里云 TSL dataType.specs 的 Json。struct 为数组，array 含 size 与 item" />
        <Column Name="FunctionBlockId" DataType="String" Description="模块标识。空表示默认模块" />
        <Column Name="Address" DataType="String" Description="点位地址。驱动采集地址，如Modbus的4x0" />
        <Column Name="PointType" DataType="String" Length="20" Description="点位类型。驱动采集的原始数据类型，如short/ushort/int/float，空表示与数据类型一致" />
        <Column Name="Scaling" DataType="Double" Description="缩放因子。原始值乘以该系数得到工程值，0表示不缩放" />
        <Column Name="Mapping" DataType="String" Length="500" Description="枚举或布尔映射。如0=关,1=开，对应 TSL specs 的键值" />
        <Column Name="Sort" DataType="Int32" Description="排序" />
        <Column Name="Enable" DataType="Boolean" Description="启用" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="创建时间" Category="扩展" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="False" Description="更新时间" Category="扩展" />
        <Column Name="Remark" DataType="String" Length="500" Description="备注" Category="扩展" />
      </Columns>
      <Indexes>
        <Index Columns="ProductId,FunctionBlockId,Identifier" Unique="True" />
      </Indexes>
    </Table>
    <Table Name="ThingEvent" Description="产品事件。物模型事件定义，设备主动上报的告警或通知">
