        <Index Columns="DeviceId" Unique="True" />
        <Index Columns="SessionId" />
      </Indexes>
    </Table>
    <Table Name="DeviceHistory" Description="设备历史。上下线、启停、服务调用、规则触发等设备生命周期记录" InsertOnly="True" MaxCacheCount="0">
