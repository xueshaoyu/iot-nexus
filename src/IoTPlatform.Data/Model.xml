        <Column Name="IP" DataType="String" Description="IP地址" />
        <Column Name="Messages" DataType="Int32" Description="消息数。本次会话上行消息数" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="上线时间" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="False" Description="活跃时间" />
