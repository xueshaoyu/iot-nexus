    </Table>
    <Table Name="Device" Description="设备。接入平台的物理或逻辑设备">
      <Columns>
        <Column Name="Id" DataType="Int32" Identity="True" PrimaryKey="True" Description="编号" />
        <Column Name="Name" DataType="String" Master="True" Description="名称" />
        <Column Name="Code" DataType="String" Nullable="False" Description="编码。DeviceName，全局唯一，用于MQTT认证与主题" />
        <Column Name="ProductId" DataType="Int32" Map="Product@Id@Name" Description="产品" />
        <Column Name="GroupId" DataType="Int32" Map="DeviceGroup@Id@Name" Description="分组" />
        <Column Name="BrokerProfileId" DataType="String" Description="MQTT 服务器。空表示使用产品默认，再回退平台默认" />
        <Column Name="Secret" DataType="String" Description="密钥。设备接入认证密钥" />
        <Column Name="Enable" DataType="Boolean" Description="启用" />
        <Column Name="Online" DataType="Boolean" Description="在线" />
        <Column Name="IP" DataType="String" Description="IP地址" />
        <Column Name="Version" DataType="String" Description="固件版本" />
        <Column Name="Location" DataType="String" Description="位置" />
        <Column Name="DriverParameter" DataType="String" Length="2000" Description="驱动参数。Json格式，覆盖产品默认参数" />
        <Column Name="PollInterval" DataType="Int32" Description="采集间隔。单位毫秒，0表示使用产品配置" />
        <Column Name="Logins" DataType="Int32" Description="上线次数" />
        <Column Name="OnlineTime" DataType="Int32" ItemType="TimeSpan" Description="在线时长。累计在线时间，单位秒" />
        <Column Name="Messages" DataType="Int64" Description="消息数。累计上行消息数" />
        <Column Name="LastOnline" DataType="DateTime" Description="最后上线" />
        <Column Name="LastOffline" DataType="DateTime" Description="最后下线" />
        <Column Name="LastActive" DataType="DateTime" Description="最后活跃。最后一次心跳或数据上报时间" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="创建时间" Category="扩展" />
        <Column Name="UpdateTime" DataType="DateTime" Nullable="False" Description="更新时间" Category="扩展" />
        <Column Name="Remark" DataType="String" Length="500" Description="备注" Category="扩展" />
      </Columns>
      <Indexes>
        <Index Columns="Code" Unique="True" />
        <Index Columns="ProductId" />
        <Index Columns="GroupId" />
        <Index Columns="UpdateTime" />
      </Indexes>
    </Table>
    <Table Name="DeviceOnline" Description="设备在线。设备当前连接会话，下线时删除">
      <Columns>
