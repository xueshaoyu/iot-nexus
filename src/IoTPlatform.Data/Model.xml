        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="时间" />
      </Columns>
      <Indexes>
        <Index Columns="DeviceId,Id" />
      </Indexes>
    </Table>
    <Table Name="DeviceProperty" Description="设备属性。设备影子，保存每个属性的最新值">
