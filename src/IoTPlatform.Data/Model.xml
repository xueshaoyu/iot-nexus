    </Table>
    <Table Name="DeviceData" Description="设备数据。属性上报的历史时序数据" InsertOnly="True" MaxCacheCount="0">
      <Columns>
        <Column Name="Id" DataType="Int64" PrimaryKey="True" DataScale="time" Description="编号" />
        <Column Name="DeviceId" DataType="Int32" Map="Device@Id@Name" Description="设备" />
        <Column Name="Name" DataType="String" Master="True" Nullable="False" Description="标识符" />
        <Column Name="Value" DataType="String" Length="2000" Description="数值" />
        <Column Name="Timestamp" DataType="Int64" Description="时间戳。设备端采集时间，Unix毫秒" />
        <Column Name="CreateTime" DataType="DateTime" Nullable="False" Description="创建时间" />
      </Columns>
      <Indexes>
        <Index Columns="DeviceId,Id" />
        <Index Columns="DeviceId,Name,Id" />
      </Indexes>
    </Table>
    <Table Name="DeviceEvent" Description="设备事件。设备上报的事件记录" InsertOnly="True" MaxCacheCount="0">
      <Columns>
        <Column Name="Id" DataType="Int64" PrimaryKey="True" DataScale="time" Description="编号" />
        <Column Name="DeviceId" DataType="Int32" Map="Device@Id@Name" Description="设备" />
        <Column Name="Type" DataType="String" Length="20" Description="类型。info/alert/error" />
        <Column Name="Name" DataType="String" Master="True" Description="名称" />
        <Column Name="Remark" DataType="String" Length="500" Description="内容" />
