        <Column Name="DeviceId" DataType="Int32" Map="Device@Id@Name" Description="设备" />
        <Column Name="ProductId" DataType="Int32" Map="Product@Id@Name" Description="产品" />
        <Column Name="SessionId" DataType="String" Description="会话。MQTT会话编号或HTTP/驱动标识" />
