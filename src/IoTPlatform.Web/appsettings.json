{
  "Urls": "http://0.0.0.0:5288",
  "ConnectionStrings": {
    "IoT": "Data Source=Data/iot.db;Cache=Shared;Default Timeout=30",
    "IoTProvider": "SQLite"
  },
  "IoT": {
    "OfflineTimeout": 90,
    "DataRetentionDays": 7,
    "DefaultPollInterval": 5000,
    "ApiKey": "",
    "Mqtt": {
      "Enable": true,
      "Mode": "Embedded",
      "TopicRoot": "iot",
      "ActiveBroker": "local",
      "Brokers": [
        {
          "Id": "local",
          "Name": "Local Mosquitto",
          "Server": "tcp://127.0.0.1:1884",
          "ClientId": "newlife-iot-platform",
          "UserName": "",
          "Password": "",
          "UseTls": false,
          "QoS": 1,
          "KeepAlive": 30,
          "ReconnectDelay": 5,
          "PublicServer": ""
        },
        {
          "Id": "emqx",
          "Name": "EMQX (TLS)",
          "Server": "tcp://emqx.example.com:8883",
          "ClientId": "newlife-iot-platform",
          "UserName": "platform",
          "Password": "",
          "UseTls": true,
          "QoS": 1
        }
      ],
      "Port": 1883,
      "PublicHost": "",
      "AdminUser": "admin",
      "AdminPassword": "admin123",
      "AllowAnonymous": false,
      "ManagementPort": 0
    },
    "AccessLog": {
      "Enable": true,
      "RetentionDays": 30,
      "TrustedProxies": [ "127.0.0.1", "::1" ],
      "ExcludePrefixes": [ "/_framework", "/_blazor", "/_content", "/css", "/js", "/lib", "/favicon.ico" ],
      "ExcludeExtensions": [ ".css", ".js", ".map", ".png", ".jpg", ".jpeg", ".gif", ".svg", ".ico", ".woff", ".woff2", ".ttf", ".wasm", ".webmanifest" ]
    },
    "Demo": {
      "SeedData": true,
      "Language": "zh-CN",
      "EnableSimulator": true,
      "ModbusPort": 1502,
      "ReportInterval": 3000
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*"
}
